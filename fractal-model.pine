//@version=6
import fstarcapital/AssetCorrelationUtils/13 as ACL
indicator('Fractal Model', overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000)

// ============================================================================
// Types - Data Only (no drawing objects stored)
// ============================================================================

type Candle
    float o
    float c
    float h
    float l
    int o_time
    int c_time    // close time - set when next candle opens
    int o_idx
    int c_idx
    int h_idx
    int l_idx
    string dow
    // Visual positions (calculated during draw)
    int candle_left
    int candle_right
    int wick_x

type Trace
    int start_idx
    float start_price


type Sweep
    float price
    int ltf_index
    int htf_candle_idx
    int swept_candle_idx
    int ltf_end_idx
    bool is_high  // true = high sweep, false = low sweep

// Completed IC-CISD (confirmed only)
type ICCisd
    float level
    int start_idx
    int end_idx
    float extreme_price
    int extreme_idx
    bool taken               // wick beyond swing high/low — line and dot go grey

type Setup
    bool is_bullish          // true = bullish setup (low sweep), false = bearish (high sweep)
    bool is_confirmed        // true when sweep is confirmed (close in range)
    bool is_post_c2          // true after C2 closes, waiting for CISD
    // Sweep data
    float sweep_price        // swept high/low price (C1 high/low)
    int sweep_ltf_idx        // LTF bar index of sweep
    int sweep_bar_idx        // bar index where sweep happened (for CISD traceback)
    int swept_candle_idx     // HTF candle that was swept (o_idx)
    int htf_candle_idx       // HTF candle that did the sweeping
    int ltf_end_idx          // LTF end point for sweep line
    int htf_count            // counts HTF candles since sweep (max 2)
    // C2 data
    int c2_x                 // bar index for C2 label (at swing point)
    float c2_y               // price for C2 label (swing high/low)
    float c2_extreme         // C2's high (bearish) or low (bullish) for price limit
    // CISD data
    float cisd_level         // CISD price level (open of opposing candles)
    int cisd_start_idx       // bar index where CISD level starts
    int cisd_end_idx         // body-break bar; line drawn to this + 1
    float tracked_extreme    // tracks high/low price for CISD (lowest low or highest high)
    int extreme_bar_idx      // bar index where the extreme occurred (for CISD traceback)
    bool has_cisd            // true when CISD level is set
    bool cisd_triggered      // true when CISD may show (body broke; in C2 also needs sweep back in)
    // IC-CISD (rebuild): opposite-candle open = level; body break confirms; one pending
    array<ICCisd> ic_list
    bool ic_active           // detection on after main CISD (through C4)
    bool ic_pending          // waiting for body break on current structure
    float ic_level           // open of opposite candle
    int ic_start_idx         // bar of that opposite candle
    float ic_extreme         // running high (bear) / low (bull) for dot — update every bar until confirm
    int ic_extreme_idx
    bool ic_seen_same_side   // true only after a real same-side candle (not doji) while pending
    float ic_last_extreme    // last confirmed IC swing extreme — next arm only if exceeds this (higher high / lower low)
    // Projection data
    float proj_anchor_1      // Point "1" - swing high (bearish) or swing low (bullish)
    float proj_anchor_0      // Point "0" - CISD candle's low (bearish) or high (bullish)
    int proj_start_idx       // Bar index where projection starts (swing point)
    int proj_end_idx         // Bar index where projection ends (CISD trigger bar)
    // Liquidity data
    float liq_c1_price       // C1 low (bearish) or high (bullish)
    int liq_c1_start_idx     // LTF bar index where C1 low/high occurred
    float liq_c0_price       // C0 low (bearish) or high (bullish) - na if condition not met
    int liq_c0_start_idx     // LTF bar index where C0 low/high occurred
    int liq_end_time         // C4's end time (for extending lines)
    int liq_c1_mitigated_idx // Bar index where C1 liq was crossed (na if not mitigated)
    int liq_c0_mitigated_idx // Bar index where C0 liq was crossed (na if not mitigated)
    bool is_done = false     // true once nothing can change anymore (skip in per-bar loop)
    // Invalidation
    bool is_invalid          // True if C3 exceeded C2 extreme after CISD triggered
    // Entry Zone C3 data
    float c2_mid             // C2 wick midpoint (high+low)/2
    float c3_open            // C3 open price
    bool ez_c3_set           // true when C3 entry zone bounds are calculated
    float ez_c3_top          // C3 zone top price
    float ez_c3_bot          // C3 zone bottom price
    int ez_c3_left_time      // C3 zone left (C3 open time)
    int ez_c3_right_time     // C3 zone right (C3 close / C4 open); na while C3 is live
    // Entry Zone C4 data
    float c3_mid             // C3 wick midpoint (high+low)/2
    float c3_extreme         // C3 high (bearish) or low (bullish) for C4 invalidation
    float c4_open            // C4 open price
    bool ez_c4_set           // true when C4 entry zone bounds are calculated
    bool ez_c4_invalid       // true when C4 invalidated (beyond C3 extreme)
    int ez_c4_invalid_time   // LTF time where C4 was invalidated (EQ stops here)
    float ez_c4_top          // C4 zone top price
    float ez_c4_bot          // C4 zone bottom price
    int ez_c4_left_time      // C4 zone left (C4 open time)
    int ez_c4_right_time     // C4 zone right (C4 close)
    // SMT data (C1-C2)
    bool has_smt             // SMT detected for this setup (C1-C2)
    int smt_x1               // SMT line start bar index
    int smt_x2               // SMT line end bar index
    float smt_y1             // SMT line start price
    float smt_y2             // SMT line end price
    string smt_symbol        // Which symbol triggered SMT (for label)
    // SMT data (C2-C3) — extra mark on a still-valid setup
    bool has_smt2
    int smt2_x1
    int smt2_x2
    float smt2_y1
    float smt2_y2
    string smt2_symbol

type CandleSettings
    string htf
    int max_display
    bool vt_show
    color vt_color
    string vt_style
    int vt_size
    bool hl_show
    color hl_color
    string hl_style
    int hl_width

type Settings
    color bull_body
    color bull_border
    color bull_wick
    color bear_body
    color bear_border
    color bear_wick
    int offset
    int width
    bool daily_name
    bool trace_show
    color trace_o_color
    string trace_o_style
    int trace_o_size
    bool label_show
    color label_color
    string label_size
    string label_position
    string dow_position
    bool fvg_show
    color fvg_color
    bool htf_label_show
    color htf_label_color
    string htf_label_size
    bool htf_timer_show
    color htf_timer_color
    string htf_timer_size
    color dow_color
    string dow_size
    bool sweep_show
    color sweep_color
    string sweep_style
    int sweep_size
    int sweep_history
    bool sweep_visible_only
    bool sweep_live
    color c2_color
    string c2_size
    bool show_c2_lbl
    bool show_c3_lbl
    bool show_c4_lbl
    // CISD settings
    bool cisd_show
    color cisd_bull_color
    color cisd_bear_color
    int cisd_width
    string cisd_style
    bool ic_cisd_show        // IC-CISD toggle (same colors/width/style as CISD)
    bool ic_cisd_alerts      // IC-CISD alert toggle (still requires global Alerts?)
    string ic_dot_size       // IC-CISD swing dot size
    // Entry Zone settings
    bool entry_zone_show
    color entry_zone_bull_color
    color entry_zone_bear_color
    // General settings
    bool alerts_enabled
    bool live_alerts_enabled
    string fractal_mode
    string custom_ltf
    string bias
    bool hide_candles
    bool hide_setups
    // Projection settings
    bool proj_show
    bool proj_label_show
    string proj_label_size
    string proj_type
    color proj_color
    int proj_width
    string proj_style
    // Liquidity settings
    bool liq_show
    color liq_color
    string liq_style
    int liq_width



type CandleSet
    array<Candle> candles
    array<Sweep> sweeps
    array<Setup> setups       // completed setups for history
    CandleSettings settings
    Trace trace
    Setup live_bearish        // tracks when high is wicked (potential bearish setup)
    Setup live_bullish        // tracks when low is wicked (potential bullish setup)
    bool has_live_bearish     // flag for bearish tracking active
    bool has_live_bullish     // flag for bullish tracking active

type PooledLine
    line id
    int x1
    float y1
    int x2
    float y2
    string xloc_value
    string extend_value
    color color_value
    string style_value
    int width_value

type PooledBox
    box id
    int left
    float top
    int right
    float bottom
    color background
    color border
    int border_width

type PooledLabel
    label id
    int x
    float y
    string label_text
    string xloc_value
    color background
    color text_color
    string style_value
    string size_value

// Drawing pool - objects survive between executions and are reused by slot.
// Index/time boxes stay separate so their coordinate domains never mix.
type DrawingBin
    array<PooledLine> lines
    array<PooledBox> index_boxes
    array<PooledBox> time_boxes
    array<PooledLabel> labels
    int line_cursor
    int index_box_cursor
    int time_box_cursor
    int label_cursor

// Tracks running high/low for SMT comparison symbols
type SMT_Tracker
    float h              // Running high of current HTF candle
    float l              // Running low
    int h_idx            // Bar index where high occurred
    int l_idx            // Bar index where low occurred
    float prev_h         // Previous HTF candle high
    float prev_l         // Previous HTF candle low
    int prev_h_idx       // Previous high bar index
    int prev_l_idx       // Previous low bar index

// ============================================================================
// Global Variables
// ============================================================================

